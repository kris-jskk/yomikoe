    "ϕ": "phi", "χ": "chi", "ψ": "psi", "ω": "omega"
  },
  "capital_greek_prefix": "capital",
  "capital_greek": {
    "Γ": "gamma", "Δ": "delta", "Θ": "theta", "Λ": "lambda",
    "Ξ": "xi", "Π": "pi", "Σ": "sigma", "Υ": "upsilon",
    "Φ": "phi", "Ψ": "psi", "Ω": "omega"
  },
  "si_prefixes": {
    "p": "pico", "n": "nano", "μ": "micro", "µ": "micro", "m": "milli",
    "c": "centi", "k": "kilo", "M": "mega", "G": "giga", "T": "tera"
  },
  "units": {
    "m": "meters", "g": "grams", "s": "seconds", "Hz": "hertz", "N": "newtons",
    "Pa": "pascals", "J": "joules", "W": "watts", "V": "volts", "A": "amperes",
    "Ω": "ohms", "mol": "moles", "L": "liters", "K": "kelvins", "eV": "electronvolts",
    "min": "minutes", "h": "hours"
  },
  "units_rule": "prefix word + unit word, US spelling, plural unless the value is 1 (5 km = 5 kilometers, 1 km = 1 kilometer); degrees Celsius stays with ING-6",
  "chemistry_rule": "element symbols letter by letter, counts as digits: H2O = h 2 o, CO2 = c o 2, NaCl = n a c l",
  "references": {
    "display number (3) at the right of an equation": "equation 3: <expression>",
    "Eq. (3), Equation (3), (3) in prose after eq": "equation 3",
    "Eqs. 3-5": "equations 3 to 5",
    "Eqs. (3) and (4)": "equations 3 and 4",
    "Theorem 2.1 <text>": "theorem 2.1, <text>",
    "Lemma, Definition, Proof, Corollary, Proposition <text>": "<word> [number], <text>"
  },
  "banned": [
    {"pattern": "\\ban element of\\b", "use": "in / not in", "why": "set membership is 'in' (ClearSpeak SetMemberSymbol=In)"},
    {"pattern": "\\bmember of\\b", "use": "in", "why": "set membership is 'in'"},
    {"pattern": "\\bbelongs to\\b", "use": "in", "why": "set membership is 'in'"},
    {"pattern": "\\bgoes to\\b", "use": "approaches (limits) / to (between sets)", "why": "arrow wording"},
    {"pattern": "\\btends to (?:infinity|zero|0)\\b", "use": "approaches", "why": "arrow wording"},
    {"pattern": "\\bcomma\\b", "use": "a written comma", "why": "commas are prosody, never spoken"},
    {"pattern": "\\bexpected value of\\b", "use": "e of", "why": "E is read as the letter; the reader cannot tell expectation from a variable E"},
    {"pattern": "\\bexpectation of\\b", "use": "e of", "why": "E is read as the letter"},
    {"pattern": "\\b(?:sin|cos|tan|sinh|cosh|tanh|ln)\\b", "use": "sine, cosine, tangent, hyperbolic ..., natural log", "why": "function names are spoken in full"},
    {"pattern": "\\b(?:superscript|subscript)\\b", "use": "sup / sub", "why": "script wording"},
    {"pattern": "\\b(?:startfraction|endfraction|startroot|endroot|baseline)\\b", "use": "the fraction ... end fraction / the square root of", "why": "MathSpeak verbose forms are not used"},
    {"pattern": "\\bnabla\\b", "use": "del", "why": "one wording for the gradient sign"},
    {"pattern": "\\b(?:to the power of|raised to)\\b", "use": "to the n / squared / cubed", "why": "power wording"},
    {"pattern": "\\bover (?:the )?(?:quantity|bracket)\\b", "use": "grouping is silent", "why": "grouping parentheses are not spoken"},
    {"pattern": "\\bsub kl\\b", "use": "sub k l", "why": "multi-letter variable subscripts are letter by letter"},
    {"pattern": "^equation \\d+(?:\\.\\d+)?,", "use": "equation N: ", "why": "display-line prefix is 'equation N:' (MATH-4)"},
    {"pattern": "\\b(?:kilo|centi|milli|micro|nano)?(?:metres?|litres?)\\b", "use": "US spelling (meters, liters)", "why": "unit spelling"},
    {"pattern": "\\b[a-z] (?:[a-z] )?(?:two|three|four|five|six)\\b(?! (?:standard|times|years))", "use": "digits (h 2 o)", "why": "numbers stay digits, including chemical counts"}
  ]
}
