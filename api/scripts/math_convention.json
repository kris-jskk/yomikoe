  "fractions_roots": {
    "a/b (slash, any parts)": "a over b",
    "stacked, one-token parts": "a over b",
    "stacked, longer parts": "the fraction a plus b over c, end fraction",
    "Leibniz derivative (stacked or slashed; numerator d, \u2202 or d^n then one symbol with optional scripts or accent; denominator the same shape)": "d y over d t; d squared y over d t squared; partial y over partial t (no fraction wrapper)",
    "numeric 1/2, 1/3, 2/3, 1/4": "1 half, 1 third, 2 thirds, 1 fourth",
    "\\sqrt{x}": "the square root of x",
    "\\sqrt[n]{x}": "the n-th root of x"
  },
  "large_operators": {
    "\\sum_{i=1}^{n}": "the sum from i equals 1 to n of",
    "\\sum_{i}": "the sum over i of",
    "\\prod_{i=1}^{n}": "the product from i equals 1 to n of",
    "\\int_a^b f dx": "the integral from a to b of f d x",
    "\\int f": "the integral of f", "\\int f(x) \\mu(dx)": "the integral of f of x with respect to mu",
    "\\lim_{x \\to a}": "the limit as x approaches a of",
    "\\max_{i}": "the maximum over i of",
    "\\min(a, b)": "the minimum of a and b",
    "\\sup_{f}": "the supremum over f of",
