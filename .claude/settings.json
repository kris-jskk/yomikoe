{
  "hooks": {
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && python3 _agent/scripts/usage_from_transcripts.py >/dev/null 2>&1; true",
            "timeout": 120,
            "async": true
          }
        ]
      }
    ]
  },
  "permissions": {
    "ask": [
      "Bash(git push*)",
      "Bash(gh pr create*)",
      "Bash(gh pr comment*)",
      "Bash(gh pr review*)",
      "Bash(gh pr merge*)",
      "Bash(gh pr edit*)",
      "Bash(gh pr close*)",
      "Bash(gh pr ready*)",
      "Bash(gh issue create*)",
      "Bash(gh issue comment*)",
      "Bash(gh issue edit*)",
      "Bash(gh issue close*)",
      "Bash(gh api -X *)",
      "Bash(gh api --method *)"
    ]
  }
}
